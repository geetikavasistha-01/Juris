{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Google API Key",
            "patterns": ["/AIza[0-9A-Za-z_-]{35}/"]
          },
          {
            "name": "Supabase Secret Key",
            "patterns": ["/sb_secret_[0-9A-Za-z_-]+/"]
          },
          {
            "name": "JSON Web Token",
            "patterns": ["/eyJ[0-9A-Za-z_-]+\\.[0-9A-Za-z_-]+\\.[0-9A-Za-z_-]+/"]
          },
          {
            "name": "Groq API Key",
            "patterns": ["/gsk_[0-9A-Za-z_-]+/"]
          }
        ]
      }
    }
  ]
}
