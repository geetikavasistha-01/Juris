# ==========================================
# Juris API & Worker - Environment Template
# ==========================================

NODE_ENV=development
PORT=3001
ROLE=all

# Supabase Services
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# LLM & Embedding Engine
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro
LLM_MODE=replay
EMBEDDING_PROVIDER=local

# Security & CORS
CORS_ORIGINS=http://localhost:5173

# Capacity Limits & Quotas
MAX_FILE_SIZE_BYTES=10485760
MAX_PDF_PAGES=50
MAX_TEXT_CHARS=100000
MAX_UPLOADS_PER_USER_PER_DAY=10
MAX_QUESTIONS_PER_USER_PER_DAY=50
MAX_CONCURRENT_JOBS_PER_USER=2
