{
  "name": "juris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r --filter=!@juris/e2e run build",
    "scan:secrets": "secretlint \"**/*\"",
    "check:requirements": "node scripts/check-requirements.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@google/genai": "^2.27.0",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^10.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.13.9",
    "echarts": "^6.1.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.4.3",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0",
    "prettier": "^3.5.2",
    "secretlint": "^10.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
